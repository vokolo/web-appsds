{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appsds",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8f6044f5-6ad0-4a3d-873d-48bef1f846b6","database_name": "nova-16d62a-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5a7bbe6adcdf46b78920948eeaab427a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
